    "demo:narrowing": "tsx src/02-narrowing.ts",
    "demo:generics": "tsx src/03-generics.ts",
    "demo:unions": "tsx src/04-discriminated-unions.ts",
    "demo:satisfies": "tsx src/05-satisfies-and-const.ts",
    "demo:result": "tsx src/06-result-pattern.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
