{
  "name": "strict-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "Strict TypeScript demos — typed examples you can run and learn from",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/index.ts",
